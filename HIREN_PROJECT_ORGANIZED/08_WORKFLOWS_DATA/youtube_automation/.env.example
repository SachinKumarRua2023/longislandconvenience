# ════════════════════════════════════════════════════════════════
#  YouTube Automation System — Environment Variables
#  Copy this file to .env and fill in your values.
#  Never commit .env to git.
# ════════════════════════════════════════════════════════════════

# ── OpenAI (required for AI summaries) ──────────────────────────
OPENAI_API_KEY=sk-...your-key-here...
# Options: gpt-4o-mini (cheap), gpt-4o (best), gpt-3.5-turbo (fastest)
OPENAI_MODEL=gpt-4o-mini

# ── YouTube Channels to monitor ─────────────────────────────────
# Format: CHANNEL_ID:Human Name   (comma-separated for multiple)
#
# How to find a Channel ID:
#   1. Open the YouTube channel page in your browser.
#   2. Right-click → View Page Source.
#   3. Search for "channelId" — copy the value (starts with UC…).
#
# Example:
YOUTUBE_CHANNELS=UCxxxxxxxxxxxxxxxxxxxxxx:My Favourite Channel,UCyyyyyyyyyyyyyyyyyyyyyy:Another Channel

# ── Scheduling ───────────────────────────────────────────────────
CHECK_INTERVAL_MINUTES=15

# ── Whisper model (used only when no transcript is available) ────
# Sizes: tiny | base | small | medium | large
# Larger = more accurate but slower and uses more RAM/VRAM
WHISPER_MODEL=base

# ── Telegram (optional) ─────────────────────────────────────────
# 1. Create a bot via @BotFather and copy the token.
# 2. Start a chat with your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates  to find your chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Discord (optional) ──────────────────────────────────────────
# Server Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=

# ── Email notifications (optional) ──────────────────────────────
# For Gmail: enable 2FA, generate an App Password at myaccount.google.com/apppasswords
EMAIL_USER=you@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_TO=recipient@example.com
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# ── Notion (optional) ────────────────────────────────────────────
# 1. Create an integration at https://www.notion.so/my-integrations
# 2. Share your target database with the integration.
# 3. Copy the database ID from the URL:
#    https://notion.so/<workspace>/<DATABASE_ID>?v=...
NOTION_API_KEY=
NOTION_DATABASE_ID=

# ── Retry / rate-limit tuning ─────────────────────────────────────
MAX_RETRIES=3
RETRY_DELAY_SECONDS=60
REQUEST_TIMEOUT_SECONDS=30
