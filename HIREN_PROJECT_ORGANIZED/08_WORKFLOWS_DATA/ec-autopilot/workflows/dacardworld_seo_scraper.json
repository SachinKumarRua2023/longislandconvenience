      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [460, 700],
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "value": "YOUR_SPREADSHEET_ID_HERE", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Errors", "mode": "name" },
        "columns": {
