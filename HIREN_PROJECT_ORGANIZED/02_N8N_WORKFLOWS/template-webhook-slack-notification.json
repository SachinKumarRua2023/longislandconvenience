{
  "name": "Template: Webhook + Slack Notification",
  "nodes": [
    {
      "parameters": {
        "path": "order-webhook",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "responseData": "{"status":"received"}"
      },
      "id": "webhook-1234",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.status }}",
              "condition": "equals",
              "value2": "pending"
            }
          ]
        }
      },
      "id": "if-1234",
      "name": "Is Status Pending?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://hooks.slack.com/services/YOUR/WEBHOOK/URL",
        "authentication": "none",
        "sendData": "otherOptions",
        "otherOptions": {
          "headers": {},
          "params": {}
        },
        "bodyParametersJson": "{\n  \"text\": \"New Order Alert!\",\n  \"blocks\": [\n    {\n      \"type\": \"header\",\n      \"text\": {\n        \"type\": \"plain_text\",\n        \"text\": \"Order #{{ $json.order_id }}\"\n      }\n    },\n    {\n      \"type\": \"section\",\n      \"fields\": [\n        {\n          \"type\": \"mrkdwn\",\n          \"text\": \"*Customer:*\\n{{ $json.customer_name }}\"\n        },\n        {\n          \"type\": \"mrkdwn\",\n          \"text\": \"*Amount:*\\n${{ $json.amount }}\"\n        }\n      ]\n    },\n    {\n      \"type\": \"actions\",\n      \"elements\": [\n        {\n          \"type\": \"button\",\n          \"text\": {\n            \"type\": \"plain_text\",\n            \"text\": \"View Order\"\n          },\n          \"url\": \"https://odoo.example.com/orders/{{ $json.order_id }}\"\n        }\n      ]\n    }\n  ]\n}"
      },
      "id": "slack-1234",
      "name": "Send Slack Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        750,
        200
      ]
    },
    {
      "parameters": {
        "url": "https://api.odoo.com/api/rest/sale_order/{{ $json.order_id }}",
        "method": "PATCH",
        "authentication": "genericCredentialType",
        "genericCredentialType": "httpBasicAuth",
        "sendData": "body",
        "contentType": "application/json",
        "body": "{\n  \"state\": \"confirmed\"\n}"
      },
      "id": "odoo-1234",
      "name": "Update Order in Odoo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        750,
        400
      ]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Is Status Pending?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Status Pending?": {
      "main": [
        [
          {
            "node": "Send Slack Message",
            "type": "main",
            "index": 0
          },
          {
            "node": "Update Order in Odoo",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "description": "This workflow: 1) Receives webhook from external system, 2) Checks if status is pending, 3) Sends Slack notification, 4) Updates Odoo with confirmed status"
  }
}
